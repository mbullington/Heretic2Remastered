# Historical source and prose are stored with CRLF. Keep those bytes stable and
# treat CR as part of the line ending during whitespace validation.
*.c -text whitespace=cr-at-eol
*.h -text whitespace=cr-at-eol
*.cpp -text whitespace=cr-at-eol
*.md -text whitespace=cr-at-eol

# Build and automation files use normalized LF.
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.txt text eol=lf
